generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  createdAt     DateTime        @default(now())
  email         String          @unique
  firstName     String
  lastName      String
  password      String
  role          UserRole
  updatedAt     DateTime
  version       Int             @default(1)
  CV            CV[]
  Discussion    Discussion[]
  Like          Like[]
  Project       Project[]
  UserAttribute UserAttribute[]
}

model Attribute {
  id       String @id @default(cuid())
  category          String
  name              String
  type              AttributeType
  options           String[]
  PositionAccessRule PositionAccessRule[]
  PositionAttribute PositionAttribute[]
  UserAttribute     UserAttribute[]
  isSystem  Boolean  @default(false)
}

model CV {
  id         String      @id @default(cuid())
  userId     String
  positionId String
  version    Int         @default(1)
  isPublished Boolean    @default(false)
  Position   Position    @relation(fields: [positionId], references: [id])
  User       User        @relation(fields: [userId], references: [id])
  Discussion Discussion[]
  Like       Like[]
  CVProject   CVProject[]

  @@unique([userId, positionId])
}
model CVProject {
  cvId      String
  projectId String
  CV        CV      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  Project   Project @relation(fields: [projectId], references: [id])

  @@id([cvId, projectId])
}

model Discussion {
  id       String @id @default(cuid())
  text     String
  cvId     String
  authorId String
  User     User   @relation(fields: [authorId], references: [id])
  CV       CV     @relation(fields: [cvId], references: [id])
}

model Like {
  cvId        String
  recruiterId String
  CV          CV     @relation(fields: [cvId], references: [id])
  User        User   @relation(fields: [recruiterId], references: [id])

  @@id([cvId, recruiterId])
}

model Position {
  id                String              @id @default(cuid())
  title             String
  version           Int                 @default(1)
  company           String
  description       String
  salaryFrom        Int?
  salaryTo          Int?
  CV                CV[]
  PositionAttribute PositionAttribute[]
  PositionAccessRule PositionAccessRule[]
}

model PositionAccessRule {
  id          String    @id @default(cuid())
  positionId  String
  attributeId String
  operator    String
  value       String
  Attribute   Attribute @relation(fields: [attributeId], references: [id])
  Position    Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
}
model PositionAttribute {
  positionId  String
  attributeId String
  required    Boolean   @default(false)
  Attribute   Attribute @relation(fields: [attributeId], references: [id])
  Position    Position  @relation(fields: [positionId], references: [id])

  @@id([positionId, attributeId])
}

model Project {
id       String @id @default(cuid())
  title       String
  description String
  tags        String[]
  startDate   DateTime
  endDate     DateTime?
  userId      String
  CVProject   CVProject[]
  User        User        @relation(fields: [userId], references: [id])
}

model UserAttribute {
  userId      String
  attributeId String
  value       String
  Attribute   Attribute @relation(fields: [attributeId], references: [id])
  User        User      @relation(fields: [userId], references: [id])

  @@id([userId, attributeId])
}

enum AttributeType {
  STRING
  TEXT
  IMAGE
  NUMERIC
  DATE
  PERIOD
  BOOLEAN
  DROPDOWN
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}
